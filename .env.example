# =======================================================
# Sepolia Deployment & Configuration
# =======================================================
# Sepolia RPC URL (from Infura, Alchemy, or QuickNode)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployer wallet private key (64 hex characters, WITHOUT 0x prefix)
# CAUTION: Use a dedicated testnet account funded only with Sepolia test ETH.
# NEVER use an account or private key that holds real mainnet assets!
DEPLOYER_PRIVATE_KEY=your_testnet_private_key_here

# Etherscan API key for contract source code verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
